# Copy this file to .env and replace with your actual API keys

# OpenRouter API Key for Llama 3.3 70B model
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# AgentOps API Key for monitoring
AGENTOPS_API_KEY=your_agentops_key_here

# Tavily API Key for web search
TAVILY_API_KEY=tvly-dev-your_tavily_key_here

# ScrapeGraph API Key for web scraping
SCRAPEGRAPH_API_KEY=sgai-your_scrapegraph_key_here
